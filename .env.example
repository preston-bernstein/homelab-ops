# Copy to .env (already gitignored -- never commit the real file) and fill
# in real values before deploying either half of this pipeline.

# Full push URL for your ntfy topic: http://<nas-host>:<ntfy-port>/<topic>.
# Treat the topic name as a shared secret -- ntfy has no auth by default, so
# anyone who knows the URL can read the feed and publish fake
# incident-detected events. Pick a fresh, unguessable topic name; don't
# reuse one that has ever appeared in a public repo or PR.
NTFY_URL=http://127.0.0.1:8080/homelab-ops
